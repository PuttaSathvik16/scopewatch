{
  "name": "@scopewatch/cli",
  "version": "0.0.2",
  "description": "Scopewatch CLI: search, install, test, activate, update, diff, rollback, status",
  "license": "MIT",
  "author": "Sathvik Putta <puttasathvik16@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PuttaSathvik16/scopewatch.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "bin": {
    "scopewatch": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "cd ../.. && npm run build",
    "build": "tsc && node -e \"try{require('fs').chmodSync('dist/main.js',0o755)}catch(e){}\"",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@scopewatch/capability-inference": "0.0.2",
    "@scopewatch/client-adapters": "0.0.2",
    "@scopewatch/diff-engine": "0.0.2",
    "@scopewatch/install-adapters": "0.0.2",
    "@scopewatch/manifest": "0.0.2",
    "@scopewatch/secrets": "0.0.2",
    "@scopewatch/state": "0.0.2",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0"
  }
}
