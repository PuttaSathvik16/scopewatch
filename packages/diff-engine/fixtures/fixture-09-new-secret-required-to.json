{
  "schemaVersion": 1,
  "version": "1.1.0",
  "source": { "type": "npm", "location": "example-tools" },
  "checksum": "sha256:to9",
  "tools": [
    { "id": "reader", "name": "File Reader", "description": "Read files" },
    { "id": "notifier", "name": "Slack Notifier", "description": "Send Slack notifications" }
  ],
  "capabilities": [
    { "tool_id": "reader", "verb": "read", "resource": "repo:owner/name", "provenance": "declared" },
    { "tool_id": "notifier", "verb": "send", "resource": "slack:*", "provenance": "declared" }
  ],
  "secrets": [
    { "id": "GITHUB_TOKEN", "description": "GitHub token", "required": true, "used_by": ["reader"] },
    { "id": "SLACK_BOT_TOKEN", "description": "Slack bot token", "required": true, "used_by": ["notifier"] }
  ]
}
