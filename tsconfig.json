{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "files": [],
  "references": [
    { "path": "packages/manifest" },
    { "path": "packages/diff-engine" },
    { "path": "packages/state" },
    { "path": "packages/install-adapters" },
    { "path": "packages/secrets" },
    { "path": "packages/client-adapters" },
    { "path": "packages/capability-inference" },
    { "path": "apps/cli" }
  ]
}
