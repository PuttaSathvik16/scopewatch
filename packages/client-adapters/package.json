{
  "name": "@scopewatch/client-adapters",
  "version": "0.0.2",
  "description": "Claude Code and Cursor client config adapters, ownership-tracked config writer, and the scopewatch-run wrapper",
  "license": "MIT",
  "author": "Sathvik Putta <puttasathvik16@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PuttaSathvik16/scopewatch.git",
    "directory": "packages/client-adapters"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "scopewatch-run": "./dist/bin/scopewatch-run.js"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "scripts": {
    "prepublishOnly": "cd ../.. && npm run build",
    "build": "tsc && node -e \"try{require('fs').chmodSync('dist/bin/scopewatch-run.js',0o755)}catch(e){}\"",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@scopewatch/state": "0.0.2",
    "@scopewatch/secrets": "0.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0"
  }
}
