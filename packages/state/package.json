{
  "name": "@scopewatch/state",
  "version": "0.0.2",
  "description": "SQLite state, lockfile, and lifecycle engine",
  "license": "MIT",
  "author": "Sathvik Putta <puttasathvik16@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PuttaSathvik16/scopewatch.git",
    "directory": "packages/state"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "cd ../.. && npm run build",
    "build": "tsc && npm run copy-schema",
    "copy-schema": "node -e \"require('fs').cpSync('src/schema','dist/schema',{recursive:true})\"",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0"
  }
}
