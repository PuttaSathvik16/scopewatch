{
  "name": "scopewatch",
  "version": "0.0.1",
  "description": "Local-first trust layer for MCP servers and AI agent tools",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --import tsx --test 'packages/**/test/**/*.test.ts'",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "lint": "eslint .",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "zod": "^3.24.0"
  }
}
