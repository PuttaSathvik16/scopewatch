{
  "schemaVersion": 1,
  "version": "1.1.0",
  "source": { "type": "npm", "location": "example-tools" },
  "checksum": "sha256:to1",
  "tools": [
    { "id": "reader", "name": "File Reader", "description": "Read files from repo" },
    { "id": "writer", "name": "File Writer", "description": "Write files to repo" }
  ],
  "capabilities": [
    { "tool_id": "reader", "verb": "read", "resource": "repo:owner/name", "provenance": "declared" },
    { "tool_id": "writer", "verb": "read", "resource": "repo:owner/name", "provenance": "declared" },
    { "tool_id": "writer", "verb": "write", "resource": "repo:owner/name", "provenance": "declared" }
  ],
  "secrets": [
    { "id": "GITHUB_TOKEN", "description": "GitHub token", "required": true, "used_by": ["reader", "writer"] }
  ]
}
